<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jessica Williams for Senate</title>
    <style>
        /* Global Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            background-color: #f8f9fa;
            color: #333;
            line-height: 1.6;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }
        
        /* Color scheme */
        :root {
            --primary: #002D72; /* Deep Blue */
            --secondary: #BE0032; /* Red */
            --accent: #FFD700; /* Gold */
            --light: #f8f9fa;
            --dark: #333;
        }
        
        /* Header Styles */
        header {
            background-color: var(--primary);
            color: white;
            padding: 20px 0;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        
        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-size: 24px;
            font-weight: bold;
            display: flex;
            align-items: center;
        }
        
        .logo span {
            color: var(--accent);
        }
        
        nav ul {
            display: flex;
            list-style: none;
        }
        
        nav ul li {
            margin-left: 20px;
        }
        
        nav ul li a {
            color: white;
            text-decoration: none;
            font-weight: 600;
            padding: 5px 10px;
            border-radius: 5px;
            transition: background-color 0.3s;
        }
        
        nav ul li a:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }
        
        .donate-button {
            background-color: var(--secondary);
            padding: 8px 16px;
            border-radius: 5px;
            font-weight: bold;
            transition: all 0.3s;
        }
        
        .donate-button:hover {
            background-color: #a00029;
            transform: scale(1.05);
        }
        
        .mobile-menu {
            display: none;
            font-size: 24px;
            cursor: pointer;
        }
        
        /* Hero Section */
        .hero {
            background: linear-gradient(rgba(0, 45, 114, 0.8), rgba(0, 45, 114, 0.8)), url('/api/placeholder/1200/600') center/cover no-repeat;
            height: 80vh;
            display: flex;
            align-items: center;
            text-align: center;
            margin-top: 70px;
            color: white;
        }
        
        .hero-content {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .hero h1 {
            font-size: 48px;
            margin-bottom: 20px;
            font-weight: 700;
        }
        
        .hero p {
            font-size: 20px;
            margin-bottom: 30px;
        }
        
        .hero-buttons {
            display: flex;
            justify-content: center;
            gap: 20px;
        }
        
        .button {
            display: inline-block;
            padding: 12px 30px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
            text-transform: uppercase;
            transition: all 0.3s;
        }
        
        .primary-button {
            background-color: var(--secondary);
            color: white;
        }
        
        .primary-button:hover {
            background-color: #a00029;
            transform: scale(1.05);
        }
        
        .secondary-button {
            background-color: transparent;
            border: 2px solid white;
            color: white;
        }
        
        .secondary-button:hover {
            background-color: rgba(255, 255, 255, 0.1);
            transform: scale(1.05);
        }
        
        /* About Section */
        .about {
            padding: 80px 0;
            background-color: white;
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 40px;
            color: var(--primary);
            font-size: 36px;
            position: relative;
        }
        
        .section-title::after {
            content: '';
            display: block;
            width: 80px;
            height: 4px;
            background-color: var(--secondary);
            margin: 10px auto;
        }
        
        .about-content {
            display: flex;
            align-items: center;
            gap: 40px;
        }
        
        .about-image {
            flex: 1;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .about-image img {
            width: 100%;
            height: auto;
            display: block;
        }
        
        .about-text {
            flex: 1;
        }
        
        .about-text h3 {
            color: var(--primary);
            margin-bottom: 15px;
            font-size: 24px;
        }
        
        .about-text p {
            margin-bottom: 20px;
            font-size: 16px;
        }
        
        /* Issues Section */
        .issues {
            padding: 80px 0;
            background-color: #f8f9fa;
        }
        
        .issues-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 30px;
        }
        
        .issue-card {
            background-color: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s;
        }
        
        .issue-card:hover {
            transform: translateY(-10px);
        }
        
        .issue-icon {
            background-color: var(--primary);
            color: white;
            padding: 20px;
            text-align: center;
            font-size: 36px;
        }
        
        .issue-content {
            padding: 20px;
        }
        
        .issue-content h3 {
            color: var(--primary);
            margin-bottom: 15px;
            font-size: 20px;
        }
        
        .issue-content p {
            margin-bottom: 15px;
            font-size: 16px;
        }
        
        .learn-more {
            color: var(--secondary);
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            margin-top: 10px;
            transition: color 0.3s;
        }
        
        .learn-more:hover {
            color: #a00029;
        }
        
        /* Events Section */
        .events {
            padding: 80px 0;
            background-color: white;
        }
        
        .events-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 30px;
        }
        
        .event-card {
            background-color: #f8f9fa;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s;
        }
        
        .event-card:hover {
            transform: translateY(-10px);
        }
        
        .event-image {
            height: 200px;
            background-size: cover;
            background-position: center;
        }
        
        .event-content {
            padding: 20px;
        }
        
        .event-date {
            color: var(--secondary);
            font-weight: bold;
            margin-bottom: 10px;
            display: block;
        }
        
        .event-content h3 {
            color: var(--primary);
            margin-bottom: 15px;
            font-size: 20px;
        }
        
        .event-content p {
            margin-bottom: 15px;
            font-size: 16px;
        }
        
        .event-location {
            display: flex;
            align-items: center;
            color: #666;
            margin-bottom: 15px;
        }
        
        .event-buttons {
            display: flex;
            gap: 10px;
        }
        
        .small-button {
            padding: 8px 16px;
            font-size: 14px;
        }
        
        /* Donate Section */
        .donate {
            padding: 80px 0;
            background: linear-gradient(rgba(0, 45, 114, 0.9), rgba(0, 45, 114, 0.9)), url('/api/placeholder/1200/600') center/cover no-repeat;
            color: white;
            text-align: center;
        }
        
        .donate h2 {
            color: white;
        }
        
        .donate h2::after {
            background-color: var(--accent);
        }
        
        .donate-content {
            max-width: 700px;
            margin: 0 auto;
        }
        
        .donate p {
            margin-bottom: 30px;
            font-size: 18px;
        }
        
        .donate-options {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 30px;
        }
        
        .donate-amount {
            background-color: rgba(255, 255, 255, 0.1);
            border: 2px solid white;
            color: white;
            padding: 12px 24px;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: bold;
        }
        
        .donate-amount:hover, .donate-amount.active {
            background-color: var(--secondary);
            border-color: var(--secondary);
        }
        
        .custom-amount {
            display: flex;
            justify-content: center;
            margin-bottom: 30px;
        }
        
        .custom-amount input {
            padding: 12px;
            width: 200px;
            border-radius: 5px 0 0 5px;
            border: none;
            font-size: 16px;
        }
        
        .custom-amount button {
            background-color: var(--secondary);
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 0 5px 5px 0;
            cursor: pointer;
            font-weight: bold;
            transition: background-color 0.3s;
        }
        
        .custom-amount button:hover {
            background-color: #a00029;
        }
        
        /* Contact Section */
        .contact {
            padding: 80px 0;
            background-color: #f8f9fa;
        }
        
        .contact-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }
        
        .contact-form {
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: var(--primary);
        }
        
        .form-group input, .form-group textarea, .form-group select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 16px;
        }
        
        .form-group textarea {
            height: 150px;
            resize: vertical;
        }
        
        .form-button {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            text-transform: uppercase;
            transition: background-color 0.3s;
        }
        
        .form-button:hover {
            background-color: #001f4f;
        }
        
        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }
        
        .info-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }
        
        .info-icon {
            background-color: var(--primary);
            color: white;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }
        
        .info-content h3 {
            color: var(--primary);
            margin-bottom: 8px;
            font-size: 20px;
        }
        
        .info-content p, .info-content a {
            color: #666;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .info-content a:hover {
            color: var(--secondary);
        }
        
        .social-media {
            display: flex;
            gap: 15px;
            margin-top: 10px;
        }
        
        .social-icon {
            background-color: var(--primary);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            transition: all 0.3s;
        }
        
        .social-icon:hover {
            background-color: var(--secondary);
            transform: translateY(-5px);
        }
        
        /* Footer */
        footer {
            background-color: var(--primary);
            color: white;
            padding: 60px 0 20px;
        }
        
        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }
        
        .footer-column h3 {
            font-size: 20px;
            margin-bottom: 20px;
            position: relative;
            padding-bottom: 10px;
        }
        
        .footer-column h3::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 50px;
            height: 3px;
            background-color: var(--secondary);
        }
        
        .footer-links {
            list-style: none;
        }
        
        .footer-links li {
            margin-bottom: 10px;
        }
        
        .footer-links a {
            color: #ddd;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .footer-links a:hover {
            color: white;
        }
        
        .footer-newsletter p {
            margin-bottom: 15px;
        }
        
        .newsletter-form {
            display: flex;
        }
        
        .newsletter-form input {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 5px 0 0 5px;
        }
        
        .newsletter-form button {
            background-color: var(--secondary);
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 0 5px 5px 0;
            cursor: pointer;
        }
        
        .copyright {
            text-align: center;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 14px;
        }
        
        /* Responsive Styles */
        @media (max-width: 992px) {
            .about-content {
                flex-direction: column;
            }
            
            .contact-content {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 768px) {
            .hero h1 {
                font-size: 36px;
            }
            
            .hero p {
                font-size: 18px;
            }
            
            .hero-buttons {
                flex-direction: column;
            }
            
            nav ul {
                display: none;
            }
            
            .mobile-menu {
                display: block;
            }
            
            .section-title {
                font-size: 28px;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <div class="container header-content">
            <div class="logo">
                <span>JW</span> Jessica Williams
            </div>
            <nav>
                <ul>
                    <li><a href="#about">About</a></li>
                    <li><a href="#issues">Issues</a></li>
                    <li><a href="#events">Events</a></li>
                    <li><a href="#contact">Contact</a></li>
                    <li><a href="#donate" class="donate-button">Donate</a></li>
                </ul>
                <div class="mobile-menu">☰</div>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container hero-content">
            <h1>Jessica Williams for U.S. Senate</h1>
            <p>Fighting for a better future for all Americans. Join our movement for progress, equity, and opportunity.</p>
            <div class="hero-buttons">
                <a href="#donate" class="button primary-button">Donate Now</a>
                <a href="#volunteer" class="button secondary-button">Volunteer</a>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="container">
            <h2 class="section-title">Meet Jessica</h2>
            <div class="about-content">
                <div class="about-image">
                    <img src="/api/placeholder/600/400" alt="Jessica Williams">
                </div>
                <div class="about-text">
                    <h3>A Lifetime of Public Service</h3>
                    <p>Jessica Williams has dedicated her life to serving her community and fighting for the values we hold dear. Born and raised in a middle-class family, Jessica understands the challenges facing everyday Americans.</p>
                    <p>As a former State Senator, Jessica has a proven track record of bringing people together to solve complex problems. She has fought tirelessly for education funding, healthcare access, and economic opportunities for all.</p>
                    <p>Now, Jessica is running for U.S. Senate to bring her experience, passion, and commitment to Washington. She believes that by working together, we can create a more just, equitable, and prosperous nation for generations to come.</p>
                    <a href="#" class="learn-more">Read Jessica's full bio</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Issues Section -->
    <section id="issues" class="issues">
        <div class="container">
            <h2 class="section-title">Key Issues</h2>
            <div class="issues-grid">
                <div class="issue-card">
                    <div class="issue-icon">🏥</div>
                    <div class="issue-content">
                        <h3>Healthcare for All</h3>
                        <p>Jessica believes healthcare is a right, not a privilege. She will fight for affordable, accessible healthcare for every American, including prescription drug price reform and protecting those with pre-existing conditions.</p>
                        <a href="#" class="learn-more">Learn More</a>
                    </div>
                </div>
                <div class="issue-card">
                    <div class="issue-icon">🌍</div>
                    <div class="issue-content">
                        <h3>Climate Action</h3>
                        <p>The climate crisis requires bold action. Jessica supports a transition to clean energy, creation of green jobs, and infrastructure investments that will protect our planet while strengthening our economy.</p>
                        <a href="#" class="learn-more">Learn More</a>
                    </div>
                </div>
                <div class="issue-card">
                    <div class="issue-icon">📚</div>
                    <div class="issue-content">
                        <h3>Education</h3>
                        <p>Quality education is the foundation of opportunity. Jessica will work to increase funding for public schools, make college more affordable, and support vocational training programs that prepare students for good-paying jobs.</p>
                        <a href="#" class="learn-more">Learn More</a>
                    </div>
                </div>
                <div class="issue-card">
                    <div class="issue-icon">💵</div>
                    <div class="issue-content">
                        <h3>Economic Justice</h3>
                        <p>Jessica believes in an economy that works for everyone. She supports raising the minimum wage, strengthening worker protections, and ensuring that corporations and the wealthy pay their fair share in taxes.</p>
                        <a href="#" class="learn-more">Learn More</a>
                    </div>
                </div>
                <div class="issue-card">
                    <div class="issue-icon">⚖️</div>
                    <div class="issue-content">
                        <h3>Justice Reform</h3>
                        <p>Our justice system should be fair and equitable. Jessica supports comprehensive criminal justice reform, ending mass incarceration, and investing in community-based alternatives that promote rehabilitation and public safety.</p>
                        <a href="#" class="learn-more">Learn More</a>
                    </div>
                </div>
                <div class="issue-card">
                    <div class="issue-icon">👪</div>
                    <div class="issue-content">
                        <h3>Family Support</h3>
                        <p>Families are the backbone of our society. Jessica advocates for paid family leave, affordable childcare, and elder care solutions that allow families to thrive while caring for their loved ones.</p>
                        <a href="#" class="learn-more">Learn More</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Events Section -->
    <section id="events" class="events">
        <div class="container">
            <h2 class="section-title">Upcoming Events</h2>
            <div class="events-list">
                <div class="event-card">
                    <div class="event-image" style="background-image: url('/api/placeholder/400/300')"></div>
                    <div class="event-content">
                        <span class="event-date">May 10, 2025 • 6:30 PM</span>
                        <h3>Town Hall: Healthcare</h3>
                        <p>Join Jessica for a discussion on healthcare policy and her plan to ensure every American has access to quality, affordable care.</p>
                        <div class="event-location">
                            📍 City Community Center, 123 Main St
                        </div>
                        <div class="event-buttons">
                            <a href="#" class="button primary-button small-button">RSVP</a>
                            <a href="#" class="button secondary-button small-button">Details</a>
                        </div>
                    </div>
                </div>
                <div class="event-card">
                    <div class="event-image" style="background-image: url('/api/placeholder/400/300')"></div>
                    <div class="event-content">
                        <span class="event-date">May 15, 2025 • 5:00 PM</span>
                        <h3>Rally for Climate Action</h3>
                        <p>Stand with Jessica as we call for bold climate policies and a transition to a clean energy economy that creates jobs and protects our planet.</p>
                        <div class="event-location">
                            📍 Central Park, 456 Park Ave
                        </div>
                        <div class="event-buttons">
                            <a href="#" class="button primary-button small-button">RSVP</a>
                            <a href="#" class="button secondary-button small-button">Details</a>
                        </div>
                    </div>
                </div>
                <div class="event-card">
                    <div class="event-image" style="background-image: url('/api/placeholder/400/300')"></div>
                    <div class="event-content">
                        <span class="event-date">May 22, 2025 • 7:00 PM</span>
                        <h3>Virtual Phone Banking</h3>
                        <p>Help us reach voters across the state! Join our virtual phone banking session to spread Jessica's message and build support for our campaign.</p>
                        <div class="event-location">
                            📍 Online (Zoom link provided after registration)
                        </div>
                        <div class="event-buttons">
                            <a href="#" class="button primary-button small-button">RSVP</a>
                            <a href="#" class="button secondary-button small-button">Details</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Donate Section -->
    <section id="donate" class="donate">
        <div class="container">
            <h2 class="section-title">Support Our Campaign</h2>
            <div class="donate-content">
                <p>Your contribution helps us fight for a better future. Every dollar makes a difference in our grassroots campaign.</p>
                <div class="donate-options">
                    <button class="donate-amount">$5</button>
                    <button class="donate-amount">$25</button>
                    <button class="donate-amount active">$50</button>
                    <button class="donate-amount">$100</button>
                    <button class="donate-amount">$250</button>
                    <button class="donate-amount">$500</button>
                </div>
                <div class="custom-amount">
                    <input type="text" placeholder="Custom Amount">
                    <button>Donate</button>
                </div>
                <a href="#" class="button primary-button">Donate Now</a>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="container">
            <h2 class="section-title">Get Involved</h2>
            <div class="contact-content">
                <div class="contact-form">
                    <form>
                        <div class="form-group">
                            <label for="name">Name</label>
                            <input type="text" id="name" placeholder="Your Name">
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" placeholder="Your Email">
                        </div>
                        <div class="form-group">
                            <label for="phone">Phone</label>
                            <input type="tel" id="phone" placeholder="Your Phone">
                        </div>
                        <div class="form-group">
                            <label for="involvement">How would you like to get involved?</label>
                            <select id="involvement">
                                <option value="">Select an option</option>
                                <option value="volunteer">Volunteer</option>
                                <option value="host">Host an Event</option>
                                <option value="donate">Make a Donation</option>
                                <option value="endorse">Endorse Jessica</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea id="message" placeholder="Your Message"></textarea>
                        </div>
                        <button type="submit" class="form-button">Submit</button>
                    </form>
                </div>
